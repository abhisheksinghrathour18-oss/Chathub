# Node Environment
NODE_ENV=development

# Server Port
PORT=3000

# Global API Route Prefix
GLOBAL_PREFIX=api

# PostgreSQL Connection String (Prisma)
DATABASE_URL="postgresql://chathub_user:chathub_password@localhost:5433/chathub_db?schema=public"

# Firebase Admin SDK Configuration
# Option 1: Firebase Project ID + Service Account file path
FIREBASE_PROJECT_ID="chathub-assessment"
FIREBASE_SERVICE_ACCOUNT_PATH=""

# Option 2: Direct service account credentials in environment
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Option 3: Local Firestore Emulator (for testing / development)
# FIRESTORE_EMULATOR_HOST="localhost:8080"

# Option 2: Direct service account credentials in environment
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Option 3: Local Firestore Emulator (for testing / development)
# FIRESTORE_EMULATOR_HOST="localhost:8080"

